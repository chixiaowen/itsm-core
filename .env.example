# itsm-core 环境变量样例（复制为 .env 后按需修改）
# 说明：环境变量优先级高于 configs/config.yaml。

# ---- 数据库（双库切换）----
# postgres | dameng
DB_DRIVER=postgres
# 可选：直接指定完整 DSN（设置后将忽略下方分库参数）
# DB_DSN=host=127.0.0.1 port=5432 user=itsm password=itsm dbname=itsm_core sslmode=disable TimeZone=UTC

# PostgreSQL（DB_DRIVER=postgres 时生效）
ITSM_DATABASE_POSTGRES_HOST=127.0.0.1
ITSM_DATABASE_POSTGRES_PORT=5432
ITSM_DATABASE_POSTGRES_USER=itsm
ITSM_DATABASE_POSTGRES_PASSWORD=itsm
ITSM_DATABASE_POSTGRES_DBNAME=itsm_core
ITSM_DATABASE_POSTGRES_SSLMODE=disable
ITSM_DATABASE_POSTGRES_TIMEZONE=UTC

# 达梦 DM8（DB_DRIVER=dameng 时生效）
ITSM_DATABASE_DAMENG_HOST=127.0.0.1
ITSM_DATABASE_DAMENG_PORT=5236
ITSM_DATABASE_DAMENG_USER=SYSDBA
ITSM_DATABASE_DAMENG_PASSWORD=SYSDBA
ITSM_DATABASE_DAMENG_SCHEMA=SYSDBA
ITSM_DATABASE_DAMENG_VARCHAR_SIZE_IS_CHAR=true

# 迁移与种子开关
ITSM_DATABASE_AUTO_MIGRATE=true
ITSM_DATABASE_SEED=true

# ---- 认证 ----
JWT_SECRET=please-change-me
ITSM_AUTH_JWT_TTL_HOURS=24

# ---- 应用与日志 ----
ITSM_APP_HTTP_ADDR=:8080
ITSM_APP_ENV=development
ITSM_APP_MAX_UPLOAD_MB=20
LOG_LEVEL=info
