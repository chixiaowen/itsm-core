# ============================================================
# itsm-core .gitignore
# ============================================================

# ---------- Go ----------
# 编译产物
/bin/
/build/
/server
*.exe
*.exe~
*.dll
*.so
*.dylib
# 测试与覆盖率
*.test
*.out
coverage.out
coverage.html
# Go workspace / vendor（本项目依赖走模块代理，不提交 vendor）
go.work
go.work.sum
/vendor/
# 调试
__debug_bin*
*.pprof

# ---------- Node / 前端 ----------
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
# 注意：frontend/package-lock.json 需要提交（CI 使用 npm ci）

# ---------- 环境文件 ----------
.env
.env.*
!.env.example

# ---------- 上传与运行时数据 ----------
/data/
uploads/

# ---------- 日志 ----------
*.log
logs/

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---------- 其他 ----------
*.tmp
tmp/
